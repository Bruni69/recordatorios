# ======================================================================
# Variables para Railway
# ----------------------------------------------------------------------
# En Railway NO se usa este archivo: cargá cada variable en el dashboard
# (Project -> Variables) o por CLI (railway variables).
# - DATABASE_URL la crea Railway automáticamente al sumar un plugin Postgres.
# - PORT lo setea Railway automáticamente (la app ya lo respeta).
# - NODE_ENV=production es necesario para que el servidor sirva el frontend.
# ======================================================================

# --- Servidor ---
PORT=3000
# Email del usuario administrador que se crea automáticamente al migrar la base existente.
# Ese usuario hereda las facturas y la configuración (settings) actuales. En instalaciones nuevas podés ignorarlo.
ADMIN_EMAIL=admin@recordatorios.local
# Contraseña del usuario administrador que se crea al migrar. OPCIONAL:
# - Si está seteada, se usa como contraseña inicial del admin.
# - Si está vacía, se genera una aleatoria que se imprime UNA vez en la consola del servidor al migrar.
APP_PASSWORD=
# Secreto para firmar los tokens JWT (mínimo 16 caracteres, OBLIGATORIO y único)
# ⚠️ En Railway usá un valor largo y aleatorio DISTINTO al que dejás en local.
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio
# Origen permitido para CORS. '*' para cualquiera (dev) o la URL del frontend en Railway (ej: https://tu-app.up.railway.app).
CORS_ORIGIN=*
# En Railway activar para que el servidor sirva el frontend compilado.
NODE_ENV=production

# --- Base de datos Supabase (PostgreSQL) ---
# En local: Supabase Project Settings -> Database -> "Transaction/Connection pooler"
# En Railway: NO setear, el plugin PostgreSQL lo inyecta solo como DATABASE_URL.
DATABASE_URL=postgresql://postgres.XXXXXXXX:[TU-CLAVE]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- EMAIL (IMAP): OPCIONAL y solo como configuración por defecto ---
# Cada usuario puede configurar su propia casilla IMAP desde la página Configuración.
# Estos valores del .env se usan únicamente si el usuario no tiene configuración propia.
# Gmail requiere "Contraseña de aplicación" (2FA activada)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tucorreo@gmail.com
IMAP_PASSWORD=tu-contrasena-de-app

# --- SMTP (enviar recordatorios por email) ---
# OBLIGATORIO para que el scheduler envíe los recordatorios por email.
# Gmail: usar "Contraseña de aplicación" (myaccount.google.com/apppasswords),
# NO la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=tu-contrasena-de-app
SMTP_FROM=tucorreo@gmail.com

# --- WhatsApp (Twilio) ---
# Crea una cuenta en console.twilio.com, activa WhatsApp Sandbox y usa tu numero de destino
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Cada usuario guarda su propio número de destino desde la app (página Configuración)

# --- Recordatorio (cron) ---
# Horario diario en que se revisan los vencimientos de TODOS los usuarios (formato cron 5 campos)
# Railway soporta procesos persistentes, así que el cron sigue funcionando adentro del contenedor.
REMINDER_CRON=0 9 * * *